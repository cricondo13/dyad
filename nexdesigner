# main.py - Flask API on Cloud Run
from flask import Flask, request, jsonify
import requests
import base64
from PIL import Image
import io

app = Flask(__name__)

@app.route('/text-to-image', methods=['POST'])
def text_to_image():
    data = request.json
    prompt = data.get('prompt')
    
    # Stability AI API call
    response = requests.post(
        "https://api.stability.ai/v1/generation/stable-diffusion-xl-1024-v1-0/text-to-image",
        headers={
            "Authorization": f"Bearer {STABILITY_API_KEY}",
            "Content-Type": "application/json",
        },
        json={
            "text_prompts": [{"text": prompt}],
            "cfg_scale": 7,
            "height": 1024,
            "width": 1024,
            "steps": 30,
        },
    )
    
    image_data = response.json()
    return jsonify({"image": image_data["artifacts"][0]["base64"]})

@app.route('/sketch-to-image', methods=['POST'])
def sketch_to_image():
    data = request.json
    sketch_base64 = data.get('sketch')
    prompt = data.get('prompt', 'realistic photo')
    
    # Convert sketch to image using ControlNet
    response = requests.post(
        "https://api.stability.ai/v1/generation/stable-diffusion-xl-1024-v1-0/image-to-image",
        headers={"Authorization": f"Bearer {STABILITY_API_KEY}"},
        files={"init_image": base64.b64decode(sketch_base64)},
        data={
            "text_prompts[0][text]": prompt,
            "init_image_mode": "IMAGE_STRENGTH",
            "image_strength": 0.35,
        }
    )
    
    return jsonify({"image": response.json()["artifacts"][0]["base64"]})

if __name__ == '__main__':
    app.run(host='0.0.0.0', port=8080)

// Interactive drawing canvas + text input
class DesignStudio {
    constructor() {
        this.canvas = document.getElementById('sketch-canvas');
        this.ctx = this.canvas.getContext('2d');
        this.isDrawing = false;
        this.setupCanvas();
    }
    
    setupCanvas() {
        this.canvas.addEventListener('mousedown', (e) => {
            this.isDrawing = true;
            this.draw(e);
        });
        
        this.canvas.addEventListener('mousemove', (e) => {
            if (this.isDrawing) this.draw(e);
        });
        
        this.canvas.addEventListener('mouseup', () => {
            this.isDrawing = false;
        });
    }
    
    draw(e) {
        const rect = this.canvas.getBoundingClientRect();
        const x = e.clientX - rect.left;
        const y = e.clientY - rect.top;
        
        this.ctx.lineWidth = 3;
        this.ctx.lineCap = 'round';
        this.ctx.strokeStyle = '#000';
        
        if (!this.isDrawing) {
            this.ctx.beginPath();
            this.ctx.moveTo(x, y);
        } else {
            this.ctx.lineTo(x, y);
            this.ctx.stroke();
        }
    }
    
    async generateFromText() {
        const prompt = document.getElementById('text-prompt').value;
        const loadingDiv = document.getElementById('loading');
        
        loadingDiv.style.display = 'block';
        
        try {
            const response = await fetch('https://your-cloud-run-url/text-to-image', {
                method: 'POST',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify({prompt})
            });
            
            const result = await response.json();
            this.displayImage(result.image);
        } catch (error) {
            console.error('Generation failed:', error);
        } finally {
            loadingDiv.style.display = 'none';
        }
    }
    
    async generateFromSketch() {
        const sketchData = this.canvas.toDataURL().split(',')[1]; // base64
        const prompt = document.getElementById('sketch-prompt').value;
        
        try {
            const response = await fetch('https://your-cloud-run-url/sketch-to-image', {
                method: 'POST',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify({
                    sketch: sketchData,
                    prompt: prompt
                })
            });
            
            const result = await response.json();
            this.displayImage(result.image);
        } catch (error) {
            console.error('Generation failed:', error);
        }
    }
    
    displayImage(base64Image) {
        const img = document.getElementById('generated-image');
        img.src = `data:image/png;base64,${base64Image}`;
        img.style.display = 'block';
    }
    
    clearCanvas() {
        this.ctx.clearRect(0, 0, this.canvas.width, this.canvas.height);
    }
}

// Initialize
const studio = new DesignStudio();

